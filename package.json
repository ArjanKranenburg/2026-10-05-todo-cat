{
  "name": "todo-cat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:start": "bash scripts/dev-server.sh start",
    "dev:stop": "bash scripts/dev-server.sh stop",
    "dev:status": "bash scripts/dev-server.sh status",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "db:generate": "drizzle-kit generate",
    "db:auth-schema": "auth generate --config scripts/auth-schema.mts --output lib/auth-schema.ts --yes && biome check --write lib/auth-schema.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:reset": "node scripts/db-reset.mts && npm run db:migrate",
    "db:seed": "tsx --conditions=react-server scripts/db-seed.mts",
    "openapi:generate": "tsx scripts/openapi.mts && biome format --write openapi.json",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "qa": "bash scripts/qa.sh",
    "ci:watch": "bash scripts/ci-watch.sh"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@libsql/client": "^0.18.0",
    "better-auth": "1.7.7",
    "drizzle-orm": "1.0.0-rc.4",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@next/env": "16.3.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "auth": "1.7.7",
    "drizzle-kit": "1.0.0-rc.4",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "workspaces": [
    "contract",
    "cli"
  ]
}
