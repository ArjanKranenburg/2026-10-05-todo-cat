# SQLite file used by Drizzle, Better Auth and Mastra memory
DATABASE_URL=file:./data/app.db
# Lissie's model through OpenRouter; the key stays on the server
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=z-ai/glm-5.3-flash
# Better Auth: secret (openssl rand -base64 32) and the app's base URL
# This is for demo-purposes only. Do NOT use real-world passwords!!!!
BETTER_AUTH_SECRET=rtZwW9Z9M97htRCStzJMhEbZh5SAiNRUfAJeqba8MYc=
BETTER_AUTH_URL=http://localhost:3000
# The CopilotKit Inspector shows in development on localhost; true hides it
COPILOTKIT_INSPECTOR_DISABLED=false
# Opt out of CopilotKit's and Mastra's usage telemetry
COPILOTKIT_TELEMETRY_DISABLED=true
MASTRA_TELEMETRY_DISABLED=true
