{
  "openapi": "3.1.0",
  "info": {
    "title": "todo-cat",
    "version": "0.1.0",
    "description": "The to-do list kept by Lissie the cat. Every to-do belongs to the signed-in user; another user's to-do is not found. Clients switch on the error code, never the message."
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/todos": {
      "get": {
        "operationId": "listTodos",
        "summary": "List to-dos: open ones first, then by due date, then oldest first.",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "schema": {
              "default": "all",
              "$ref": "#/components/schemas/TodoStatus"
            }
          },
          {
            "in": "query",
            "name": "search",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The to-dos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TodoList"
                }
              }
            }
          },
          "400": {
            "description": "Error `validation-failed`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Error `unauthorized`.",
            "headers": {
              "www-authenticate": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "Bearer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "addTodo",
        "summary": "Add a to-do.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTodoInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The new to-do.",
            "headers": {
              "location": {
                "required": true,
                "description": "/api/todos/<id>",
                "schema": {
                  "type": "string",
                  "description": "/api/todos/<id>"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Todo"
                }
              }
            }
          },
          "400": {
            "description": "Error `validation-failed`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Error `unauthorized`.",
            "headers": {
              "www-authenticate": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "Bearer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/todos/{id}": {
      "get": {
        "operationId": "getTodo",
        "summary": "Get one to-do.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string",
              "description": "The to-do's id."
            },
            "required": true,
            "description": "The to-do's id."
          }
        ],
        "responses": {
          "200": {
            "description": "The to-do.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Todo"
                }
              }
            }
          },
          "401": {
            "description": "Error `unauthorized`.",
            "headers": {
              "www-authenticate": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "Bearer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Error `todo-not-found`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateTodo",
        "summary": "Change a to-do's title, due date (null clears it) or done state.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string",
              "description": "The to-do's id."
            },
            "required": true,
            "description": "The to-do's id."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTodoInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated to-do.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Todo"
                }
              }
            }
          },
          "400": {
            "description": "Error `validation-failed`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Error `unauthorized`.",
            "headers": {
              "www-authenticate": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "Bearer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Error `todo-not-found`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteTodo",
        "summary": "Delete a to-do for good.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string",
              "description": "The to-do's id."
            },
            "required": true,
            "description": "The to-do's id."
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted; no body."
          },
          "401": {
            "description": "Error `unauthorized`.",
            "headers": {
              "www-authenticate": {
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "Bearer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Error `todo-not-found`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TodoStatus": {
        "type": "string",
        "enum": ["open", "done", "all"]
      },
      "CreateTodoInput": {
        "type": "object",
        "properties": {
          "title": {
            "description": "Trimmed, with inner whitespace collapsed to one space; then 1 to 200 characters.",
            "type": "string",
            "minLength": 1
          },
          "dueDate": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "description": "A calendar day without time, yyyy-mm-dd."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["title"],
        "additionalProperties": false
      },
      "UpdateTodoInput": {
        "type": "object",
        "properties": {
          "title": {
            "description": "Trimmed, with inner whitespace collapsed to one space; then 1 to 200 characters.",
            "type": "string",
            "minLength": 1
          },
          "dueDate": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "description": "A calendar day without time, yyyy-mm-dd."
              },
              {
                "type": "null"
              }
            ]
          },
          "done": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "minProperties": 1
      },
      "TodoList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Todo"
        }
      },
      "Todo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "dueDate": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "description": "A calendar day without time, yyyy-mm-dd."
              },
              {
                "type": "null"
              }
            ]
          },
          "done": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "title",
          "dueDate",
          "done",
          "createdAt",
          "completedAt"
        ],
        "additionalProperties": false
      },
      "ErrorBody": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "$ref": "#/components/schemas/ErrorCode"
              },
              "message": {
                "type": "string"
              }
            },
            "required": ["code", "message"],
            "additionalProperties": false
          }
        },
        "required": ["error"],
        "additionalProperties": false
      },
      "ErrorCode": {
        "type": "string",
        "enum": ["unauthorized", "todo-not-found", "validation-failed"]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "A Better Auth session token: from the `set-auth-token` header of a sign-in, or from `todo-cat login`."
      }
    }
  }
}
