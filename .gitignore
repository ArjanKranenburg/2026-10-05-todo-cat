# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (root and npm workspaces: cli/, contract/)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js (.next-e2e*/ are e2e dev server output dirs)
/.next/
/.next-e2e*/
/out/

# build output (root and workspaces)
/build
dist/

# local SQLite databases (data/ has its own .gitignore as well)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Mastra build/dev output
.mastra/

# background dev server state (scripts/dev-server.sh)
/.dev-server/

# throwaway files for the human, never committed (public/playground/ is served by the dev server)
/playground/
/public/playground/

# misc
.DS_Store
*.pem

# debug / logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (only the example is committed)
.env*
!.env.example

# vercel
.vercel

# editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# typescript
*.tsbuildinfo
next-env.d.ts

# impeccable engine binary (platform-specific, downloaded on first use)
.claude/skills/impeccable/scripts/bin/

# Claude Code worktrees
.claude/worktrees/
