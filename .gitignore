# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (root and npm workspaces: cli/, contract/)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
/.next/
/out/

# build output (root and workspaces)
/build
dist/

# local SQLite databases (data/ has its own .gitignore as well)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Mastra build/dev output
.mastra/

# misc
.DS_Store
*.pem

# debug / logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (only the example is committed)
.env*
!.env.example

# vercel
.vercel

# editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# typescript
*.tsbuildinfo
next-env.d.ts
